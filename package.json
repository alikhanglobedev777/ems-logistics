{
  "name": "ems-logistics",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm build:shared && turbo dev",
    "dev:api": "pnpm build:shared && pnpm --filter @ems/api dev",
    "dev:web": "pnpm build:shared && pnpm --filter @ems/web dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test:api": "pnpm build:shared && pnpm --filter @ems/api test",
    "contract:lint": "pnpm --filter @ems/api-contract lint",
    "contract:generate": "pnpm --filter @ems/api-contract generate-types && pnpm --filter @ems/api-client generate",
    "db:migrate": "pnpm --filter @ems/db migrate",
    "db:generate-types": "pnpm --filter @ems/db generate-types",
    "check": "pnpm build:shared && pnpm db:migrate && pnpm contract:generate && pnpm typecheck && pnpm test:api",
    "build:shared": "pnpm --filter @ems/shared build"
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "latest"
  }
}
